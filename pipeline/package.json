{
  "name": "@meld/design-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mvp": "node --import tsx src/cli.ts",
    "observe": "node --import tsx src/observation-cli.ts",
    "setup": "bash scripts/setup.sh",
    "import": "node --import tsx src/import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "dotenv": "^17.2.0",
    "fast-xml-parser": "^5.3.0",
    "yauzl": "^3.2.0",
    "zod": "^4.4.3",
    "openai": "7.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/src/integration.d.ts",
      "import": "./dist/src/integration.js"
    }
  },
  "files": [
    "dist/src",
    "prompts",
    "config",
    "skills"
  ]
}
