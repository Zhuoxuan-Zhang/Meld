{
  "name": "meld-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../pipeline run build",
    "prebuild": "npm --prefix ../pipeline run build && npm --prefix ../backend run typecheck",
    "prepreview": "npm --prefix ../pipeline run build",
    "dev": "node ../scripts/serve.mjs",
    "build": "tsc -b && vite build",
    "preview": "node ../scripts/serve.mjs --preview",
    "test": "playwright test",
    "setup:market": "bash scripts/setup-market.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
