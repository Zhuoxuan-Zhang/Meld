+      await write(path.join(dir, 'synthesis/fragment-validation-0-2.json'), { fragment_calls: state.calls.map((c: any) => c.id) });
+      const model = { provider: 'codex_cli', prompt: async () => 'synthetic', ask: async (label: string) => {
