+let directory: string;
+let pids: number[] = [];
+beforeEach(async () => {
+  directory = await mkdtemp(path.join(os.tmpdir(), 'meld-codex-cancel-test-'));
+  const bin = path.join(directory, 'bin');
+  await mkdir(bin);
+  // Like the real CLI launcher, this fixture starts a child that inherits its
+  // output pipes. Killing just the launcher would leave execution hanging.
+  await writeFile(path.join(bin, 'codex'), `#!/usr/bin/env node
+const { spawn } = require('node:child_process');
+const fs = require('node:fs');
+const path = require('node:path');
+const answer = process.argv[process.argv.indexOf('--output-last-message') + 1];
+const child = spawn(process.execPath, ['-e', 'setInterval(() => {}, 1000)'], { stdio: 'inherit' });
+fs.writeFileSync(path.join(path.dirname(answer), 'started.json'), JSON.stringify([process.pid, child.pid]));
+setInterval(() => {}, 1000);
+`, { mode: 0o755 });
+  vi.stubEnv('PATH', `${bin}${path.delimiter}${process.env.PATH}`);
+});
+afterEach(async () => {
+  for (const pid of pids) { try { process.kill(pid, 'SIGKILL'); } catch { /* already stopped */ } }
+  pids = [];
+  vi.unstubAllEnvs();
+  await rm(directory, { recursive: true, force: true });
+});
+const request = { model: 'fixture', reasoning_effort: 'low', schema: {}, prompt: 'Wait for cancellation.' };
+async function started(run: string) {
+  await expect.poll(async () => {
+    try { pids = JSON.parse(await readFile(path.join(run, 'started.json'), 'utf8')); return pids.length; } catch { return 0; }
+  }, { timeout: 5000 }).toBe(2);
+}
+async function stopped() {
+  await expect.poll(() => pids.every(pid => {
+    try { process.kill(pid, 0); return false; } catch { return true; }
+  }), { timeout: 5000 }).toBe(true);
+}
+
+it('does not start the CLI for an already cancelled request', async () => {
+  const controller = new AbortController(); controller.abort();
+  const run = path.join(directory, 'cancelled');
+  await expect(executeCodex(run, request, 5000, controller.signal)).rejects.toMatchObject({ name: 'AbortError' });
