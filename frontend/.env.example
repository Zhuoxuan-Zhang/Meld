# Feature summaries run your own Claude Code (claude -p) on its subscription.
# Optional: the CLI, the folder of a logged-in account (its CLAUDE_CONFIG_DIR),
# and the model.
MELD_CLAUDE_BIN=
MELD_CLAUDE_CONFIG_DIR=
MELD_CLAUDE_MODEL=claude-haiku-5-5

# Expanded market search. The full ranking is screened for simple local scope.
MELD_MARKET_CANDIDATES=90
# Selected APKs, named <package.id>.apk. Defaults to .meld-cache/apks.
MELD_APK_DIR=
# Optional existing pipeline tool bundle and model configuration.
MELD_PIPELINE_TOOL_ROOT=
MELD_PIPELINE_CONFIG=
MELD_DESIGN_EXAMPLE=
# Optional saved delivery project(s) featured on the homepage. Stale/unbuilt
# projects are hidden; these IDs refer to this installation's local cache.
MELD_PROJECT_EXAMPLE=
MELD_PROJECT_EXAMPLES=

# Android coding/build worker. macOS Android Studio paths are detected.
MELD_ANDROID_SDK=
JAVA_HOME=
MELD_AAPT=
# Best-effort reference APK acquisition; false uses local APKs only.
MELD_APK_AUTO_DOWNLOAD=true

# Optional explicit coding/review provider; defaults to claude_cli.
MELD_BUILD_PROVIDER=claude_cli
MELD_CODEX_BUILD_MODEL=gpt-6.1-sol
# Optional screenshot-provider override; otherwise uses the pipeline SDK's adb.
# REA_ADB_PATH=/absolute/path/to/android-sdk/platform-tools/adb
