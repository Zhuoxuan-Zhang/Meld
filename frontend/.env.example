# Copy to .env.local. Keep your key on the local server, never in VITE_ variables.
OPENROUTER_API_KEY=
# Optional model override. Requires structured JSON output support.
MELD_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Feature summaries run your own Claude Code (claude -p) on its subscription.
# Optional: the CLI, the folder of a logged-in account (its CLAUDE_CONFIG_DIR),
# and the model.
MELD_CLAUDE_BIN=
MELD_CLAUDE_CONFIG_DIR=
MELD_CLAUDE_MODEL=claude-haiku-5-5
